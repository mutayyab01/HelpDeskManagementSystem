@page
@model LockoutModel
@{
    ViewData["Title"] = "Deactivate Account";
}
<head>
    <style type="text/css">
        body {
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .lockout-card {
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
            overflow: hidden;
            max-width: 450px;
            background: white;
            animation: fadeIn 0.5s ease-out;
        }

        .lockout-header {
            background: linear-gradient(45deg, #ff6b6b, #ff8e8e);
            color: white;
            text-align: center;
            padding: 30px 20px;
        }

        .lockout-icon {
            font-size: 5rem;
            margin-bottom: 15px;
            animation: shake 1.5s ease infinite;
        }

        .lockout-body {
            padding: 30px;
        }

        .contact-options {
            margin-top: 25px;
        }

        .contact-item {
            display: flex;
            align-items: center;
            margin-bottom: 15px;
            padding: 12px 15px;
            border-radius: 10px;
            background-color: #f8f9fa;
            transition: all 0.3s;
        }

            .contact-item:hover {
                background-color: #e9ecef;
                transform: translateX(5px);
            }

        .contact-icon {
            font-size: 1.5rem;
            margin-right: 15px;
            width: 30px;
            text-align: center;
        }

        .btn-home {
            background: linear-gradient(45deg, #5a67d8, #4c51bf);
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 50px;
            margin-top: 20px;
            transition: all 0.3s;
        }

            .btn-home:hover {
                transform: translateY(-3px);
                box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
            }

        @@keyframes shake {
            0%, 100% {
                transform: rotate(0);
            }

            10%, 30%, 50%, 70%, 90% {
                transform: rotate(-5deg);
            }

            20%, 40%, 60%, 80% {
                transform: rotate(5deg);
            }
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</head>
<div class="container d-flex justify-content-center align-items-center">
    <div class="lockout-card">
        <div class="lockout-header">
            <div class="lockout-icon">
                <i class="fas fa-lock"></i>
            </div>
            <h1 class="h2">Account Deactivated</h1>
        </div>
        <div class="lockout-body">
            <p class="lead text-center text-muted">
                This account has been temporarily deactivated. Please contact the system administrator to resolve this issue.
            </p>

            <div class="contact-options">
                <h5 class="mb-4 text-center">Contact Options:</h5>

                <div class="contact-item">
                    <div class="contact-icon text-primary">
                        <i class="fas fa-envelope"></i>
                    </div>
                    <div>
                        <h6 class="mb-0">Email Admin</h6>
                        <small class="text-muted">mutayyab786yo@gmail.com</small>
                    </div>
                </div>

                <div class="contact-item">
                    <div class="contact-icon text-success">
                        <i class="fas fa-phone"></i>
                    </div>
                    <div>
                        <h6 class="mb-0">Call Support</h6>
                        <small class="text-muted">+92 (345) 784-8519</small>
                    </div>
                </div>

                <div class="contact-item">
                    <div class="contact-icon text-info">
                        <i class="fas fa-ticket-alt"></i>
                    </div>
                    <div>
                        <h6 class="mb-0">Submit a Ticket</h6>
                        <small class="text-muted"><a href="https://github.com/mutayyab01">Github</a></small>
                    </div>
                </div>
            </div>

            <div class="text-center mt-4">
                <a class="btn btn-home" href="~/Identity/Account/Login">
                    <i class="fas fa-home me-2"></i>Return to Homepage
                </a>
            </div>
        </div>
    </div>
</div>


